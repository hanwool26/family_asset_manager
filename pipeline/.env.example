# --- MongoDB ---
# Atlas 연결 문자열. web/.env 의 MONGODB_URI 와 동일한 값을 써야 프론트에 반영됨.
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="stock_analyzer"

# --- 뉴스 수집 ---
# 2026-07-31부로 NAVER 검색 API가 NAVER API HUB(NCP)로 이전됨. NCP 콘솔 → NAVER API HUB 에서
# 발급받은 Client ID/Secret을 쓸 것 (developers.naver.com 키는 더 이상 동작하지 않음).
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
MARKETAUX_API_KEY=""

# --- Claude 호출 ---
# cli: claude CLI subprocess 사용 (기본값) / api: Anthropic API SDK 사용
AI_BACKEND="cli"
CLAUDE_MODEL="claude-sonnet-5"
# AI_BACKEND=api 일 때 필수. AI_BACKEND=cli 여도 claude CLI가 이 값으로 인증할 수 있음(로그인 불필요).
ANTHROPIC_API_KEY=""

# --- 실행 파라미터 (기본값은 methodology.html 기준, 보통 건드릴 필요 없음) ---
MAX_ARTICLES=200
CLASSIFY_BATCH_SIZE=25
SUMMARY_ARTICLES_PER_CATEGORY=30
MAX_CLAUDE_CALLS=26
CLAUDE_TIMEOUT_SECONDS=300
CLAUDE_CALL_INTERVAL_SECONDS=2.0
NAVER_RATE_LIMIT_SECONDS=0.2
MARKETAUX_RATE_LIMIT_SECONDS=1.0

# 로컬 중간 산출물/로그 보관 위치 및 보관일수
PIPELINE_DATA_DIR="./data"
PIPELINE_DATA_RETENTION_DAYS=30

TZ="Asia/Seoul"

# --- 포트폴리오 등락률 TOP5 뉴스 파이프라인 (run_portfolio_movers.py) ---
# 배포된 web 앱 URL (GET {PORTFOLIO_API_URL}/api/portfolio/movers 호출에 사용).
PORTFOLIO_API_URL=""
# web/.env 의 PIPELINE_API_TOKEN 과 동일한 값을 넣을 것.
PIPELINE_API_TOKEN=""
PORTFOLIO_MOVERS_TOP_N=5
PORTFOLIO_NEWS_ARTICLES_PER_STOCK=5
