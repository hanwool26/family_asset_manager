# Postgres connection string (required). Get one free via `npx create-db`
# or a Vercel/Neon/Supabase Postgres instance.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Anthropic API key for AI 코칭 (optional — can also be set from the app's
# 설정 dialog, which stores it in the AppSetting table instead).
ANTHROPIC_API_KEY=""

# Optional override for the coaching model.
# ANTHROPIC_COACHING_MODEL="claude-sonnet-5"

# PIN used to unblur 포트폴리오/가계자산/AI 코칭 (see the 🔒 control in the
# header). Leave unset to disable the PIN gate (e.g. local dev).
BASIC_AUTH_PASSWORD=""

# MongoDB connection string for 시장분석 리포트 (optional — must match the
# MONGODB_URI used by the pipeline/ Raspberry Pi job). If unset, /reports and
# the homepage fall back to lib/mock-reports.ts sample data.
MONGODB_URI=""
MONGODB_DB="stock_analyzer"

# Bearer 토큰 — pipeline/ (라즈베리파이) 의 run_portfolio_movers.py가
# GET /api/portfolio/movers 호출 시, 그리고 notify_client.py가 POST /api/notify/kakao
# 호출 시 인증에 사용. pipeline/.env의 PIPELINE_API_TOKEN과 동일한 값이어야 한다.
# 미설정 시 해당 API들은 503을 반환.
PIPELINE_API_TOKEN=""

# 카카오톡 "나에게 보내기" 알림 (리포트 발행 / AI Investor 승인 요청). 카카오 개발자 콘솔
# (developers.kakao.com) > 내 애플리케이션 > 앱 키에서 REST API 키를 발급받아 채운다.
# CLIENT_SECRET은 "카카오 로그인 > 보안"에서 생성 후 반드시 "사용함"으로 켜야 한다(선택이지만 권장).
# /investor 페이지의 "카카오 알림" 버튼으로 최초 1회 로그인 동의를 완료해야 실제 발송이 시작된다.
KAKAO_REST_API_KEY=""
KAKAO_CLIENT_SECRET=""
